{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unyt-watchtower",
  "account_id": "3ad68e5ee4d2368167fa7a62d667c158",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "watchtower.unyt.dev/ingest",   "zone_name": "unyt.dev" },
    { "pattern": "watchtower.unyt.dev/ingest/*", "zone_name": "unyt.dev" },
    { "pattern": "watchtower.unyt.dev/healthz",  "zone_name": "unyt.dev" },
    { "pattern": "watchtower.unyt.dev/api/*",    "zone_name": "unyt.dev" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "watchtower",
      "database_id": "4d9bd50a-6b89-43f3-b402-c62b2ef51e2c",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "SCHEMA_VERSION": "1",
    "OBSERVER_TS_SKEW_SECS": "600",
    "ALLOWED_ORIGINS": "https://watchtower.unyt.dev,http://localhost:5173"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
